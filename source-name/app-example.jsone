{
  "id": //usually the name of the file itself on the original repositor,
  "name": //name of the app,
  "version:" //version of the app,
  "author": //original creator of the app,
  "uploader": //person who uploaded this entry,
  "source": //id of the repository which is the source, MUST be the same as in sources.json,
  "category": []//category of the app, MUST be one in the category of the repo in sources.json,
  "description": //description of the app,
  "dateOriginal": //date of creation of the app, or upload on the original source,
  "dateSource": //date of upload on the Ecureuil repo,
  "size": //size in bytes,
  "dependencies": [] //dependencies needed by the app,
  "instructionSteps": [] //steps needed to be done by the user to install it, if any,
  "isImmersive": //true or false, true if its a Metro or UWP app, false otherwise,
  "links": [] //any links for the app you might want to,
  "installParameters": [] //parameters to install,
  "DownloadPath": //the name or path of the executable that should be run on the computer
  "fileType": //extension of the file downloaded, 
  "uninstallParameters": [] //parameters for uninstall,
  "isPortable": //true or false, true if it's portable, false if it's an installer,
  "compatibility": [] //array as ["8.0", "8.1", "10"]. Remember to add all versions which are supported,
  "architecture": //arm32 for RT, or other architectures,
  "iconUrl": //url for the icon,
  "screenshots": [] //array of URLs of the screenshots,
  "downloadUrl": //download URL must be openable in IE9 or superior,
  "language": [] //language in which the app is offered; must be an array,
  "isTrial": //true or false, true if it's trial version, otherwise false
}

//dates should be in the format YYYY-MM-DD, and contain no time
//size must be in bytes; will be converted automatically by Ecureuil
//languages must be written in standard format, e.g. en-US
//architectures must be written as: arm32, arm64, x86-32, x86-64. Other formats will be displayed not formatted in the front-end
//fileType is essential, as this is used to automatically determine the installation method
  //DownloadPath is essential: it must be the path (from the root of the downloaded package) or the name of the executable that should be run by the user. If you have a zip with your app inside /bin/App.exe, this is what DownloadPath should have
  //It must be correct otherwise Ecureuil can't either execute correctly the setup inside a .zip file, or correctly copy the file in Program Fiels, and then add the start menu entry
